<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent">
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:background="@android:color/transparent" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCustomizeContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:layout_marginVertical="8dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="24dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LibraryContainer">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="true"
                android:padding="8dp"
                android:layout_margin="2dp">
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back_2"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtElementTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="Project Scene"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <include
                    android:id="@+id/layoutCustomizeMain1"
                    layout="@layout/ccs_customize_main_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />
                <include
                    android:id="@+id/layoutCustomizeMain2"
                    layout="@layout/ccs_customize_main_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>