<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewItemBg"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:background="@drawable/bg_button_pill"
    android:backgroundTint="?attr/colorSecondaryContainer">
    <View
        android:id="@+id/viewActiveBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_song_item_shape"
        android:backgroundTint="?attr/colorAccent"
        android:alpha="0.2"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/imgArtBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LibraryItemArt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/imgArt"
        app:layout_constraintEnd_toStartOf="@id/imgLyricIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/txtItemLine1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_color_primary_song_item"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/txtItemLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_color_secondary_song_item"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/btnItemMore"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_overflowv_2_s"
        app:tint="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/txtItemDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:textColor="@color/text_color_secondary_song_item"
        android:textSize="12sp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnItemMore"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/imgDownloaded"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:visibility="gone"
        android:src="@drawable/ic_download"
        app:tint="?attr/colorAccent"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgLyricIcon"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/imgLyricIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:visibility="gone"
        android:src="@drawable/ic_text"
        app:tint="@color/text_color_secondary_song_item"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtItemDuration"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/txtNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/imgArt"
        app:layout_constraintStart_toStartOf="@id/imgArt"
        app:layout_constraintTop_toTopOf="@id/imgArt" />
</androidx.constraintlayout.widget.ConstraintLayout>