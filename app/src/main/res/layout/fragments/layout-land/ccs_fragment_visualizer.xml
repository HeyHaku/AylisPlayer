<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.aylis.MainActivity">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_half"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />
    <LinearLayout
        android:id="@+id/weightContainer"
        android:layout_margin="4dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_half"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/visualizerFrame"
            android:layout_width="match_parent"
            android:elevation="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/player_background"
            android:clipToOutline="true">
            <com.aylis.comp.visual.core.VisualizerViewCore
                android:id="@+id/surfaceViewVisualizer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />
        </androidx.media3.ui.AspectRatioFrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutAspectRatioMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_rounded"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp"
        android:layout_margin="2dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/layoutButtons"
        app:layout_constraintStart_toStartOf="@+id/layoutButtons"
        app:layout_constraintTop_toBottomOf="@+id/layoutButtons"
        >
        <LinearLayout
            android:id="@+id/btnAspectFull"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspectFull"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspectFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Full"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect9_19"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect9_19"
                android:layout_width="13dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect9_19"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="9:19"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect9_16"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect9_16"
                android:layout_width="15dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect9_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="9:16"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect16_9"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect16_9"
                android:layout_width="26dp"
                android:layout_height="15dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect16_9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="16:9"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect4_3"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect4_3"
                android:layout_width="26dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect4_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="4:3"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect3_4"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect3_4"
                android:layout_width="20dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect3_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="3:4"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAspect1_1"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            >
            <View
                android:id="@+id/iconAspect1_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_ratio_icon"
                android:backgroundTint="?android:attr/textColorSecondary"
                />
            <TextView
                android:id="@+id/txtAspect1_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1:1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:layout_margin="2dp"
        android:fitsSystemWindows="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline_half"
        app:layout_constraintTop_toTopOf="parent"
        >
        <ImageButton
            android:id="@+id/btn0"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid"
            app:tint="?attr/colorOnSurfaceVariant"
            />
        <ImageButton
            android:id="@+id/btn1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pencil"
            app:tint="?attr/colorOnSurfaceVariant"
            />
        <ImageButton
            android:id="@+id/btn5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_aspect"
            app:tint="?attr/colorOnSurfaceVariant"
            />
        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_export"
            app:tint="?attr/colorOnSurfaceVariant"
            />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>