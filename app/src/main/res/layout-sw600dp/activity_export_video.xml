<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/transparent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp">
        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/bg_popup_rounded_fg"
            android:elevation="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_title"
                android:textColor="?attr/colorTertiary"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:id="@+id/layoutDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <TextView
                    android:id="@+id/txtDownloadProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_status_downloading"
                    android:textColor="?attr/colorPrimaryContainer"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="24dp"/>
                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:max="10000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_custom_progress"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutExportProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">
                <TextView
                    android:id="@+id/txtExportProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="?attr/colorPrimaryContainer"
                    android:textAppearance="?attr/textAppearanceDisplayMedium"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="24dp"/>
                <ProgressBar
                    android:id="@+id/exportProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_custom_progress"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelExport"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/export_btn_cancel"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:cornerRadius="28dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>