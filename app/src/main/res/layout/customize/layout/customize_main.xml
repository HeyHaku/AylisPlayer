<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCustomizeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        app:cardBackgroundColor="@color/black_alpha_2"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="12dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LibraryContainer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_indicator"
                android:clipToOutline="true"
                android:padding="2dp"
                android:layout_margin="8dp">
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back_2"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtElementTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:padding="4dp"
                    android:text="Project Scene"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                     />
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <include
                    android:id="@+id/layoutCustomizeMain1"
                    layout="@layout/customize_main_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />
                <include
                    android:id="@+id/layoutCustomizeMain2"
                    layout="@layout/customize_main_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>