<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">
    <com.aylis.comp.visual.ambient.AmbientBackgroundView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ambientProfile="main"/>
    <com.aylis.CustomViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        tools:context=".MyActivity" />
    <View
        android:id="@+id/scrimDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:alpha="0.3"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />
    <RelativeLayout
        android:id="@+id/media_controls_root"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:elevation="8dp">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/layoutMediaControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <FrameLayout
                android:id="@+id/player_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="8dp"
                android:background="@android:color/transparent"
                app:behavior_peekHeight="146dp"
                app:behavior_hideable="false"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
                <include layout="@layout/player_unified" />
            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="24dp"
            android:elevation="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pill"
            app:cardCornerRadius="28dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="0.75dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <nl.joery.animatedbottombar.AnimatedBottomBar
                    android:id="@+id/bottomNavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@color/transparent"
                    app:abb_tabAnimationSelected="slide"
                    app:abb_iconSize="24dp"
                    app:abb_selectedTabType="text"
                    app:abb_indicatorAppearance="round"
                    app:abb_indicatorAnimation="slide"
                    app:abb_tabAnimation="slide"
                    app:abb_animationInterpolator="@android:interpolator/fast_out_slow_in"
                    app:abb_animationDuration="250"
                    app:abb_indicatorColor="?attr/colorPrimaryContainer"
                    app:abb_tabColor="?attr/colorOnSurface"
                    app:abb_tabColorSelected="?attr/colorOnSurface"
                    app:abb_tabs="@menu/bottom_nav_menu" />
            </FrameLayout>
            <com.aylis.comp.visual.ambient.AmbientBackgroundView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:ambientProfile="plM" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</RelativeLayout>