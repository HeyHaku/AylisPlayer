<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_unified_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layoutExpandedControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:visibility="invisible">
        <com.aylis.comp.visual.ambient.AmbientBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ambientProfile="plB" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutExpandedInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:clickable="true"
            android:focusable="true">
            <ImageButton
                android:id="@+id/btnCollapseExpanded"
                style="@style/ExpressiveImageButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_expand2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?android:attr/textColorPrimary" />
            <LinearLayout
                android:id="@+id/headerTitleContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/btnCollapseExpanded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnCollapseExpanded"
                >
                <TextView
                    android:id="@+id/txtHeaderPlayingFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="AYLIS PLAYER"
                    android:textAllCaps="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/txtHeaderPlaylistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Playing Queue"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnOverflowExpanded"
                style="@style/ExpressiveImageButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_overflowv_2_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?android:attr/textColorPrimary" />
            <View
                android:id="@+id/albumArtPlaceholderExpanded"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toTopOf="@id/titleSectionContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerTitleContainer" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titleSectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/seekBarSongProgressExpanded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <LinearLayout
                    android:id="@+id/textContainerExpanded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDownloadExpanded"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/txtSongTitleExpanded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Song Title" />
                    <TextView
                        android:id="@+id/txtSongArtistExpanded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp"
                        tools:text="Artist Name" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btnDownloadExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_download"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnLikeExpanded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorPrimary" />
                <TextView
                    android:id="@+id/txtDownloadProgressExpanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/btnDownloadExpanded"
                    app:layout_constraintEnd_toEndOf="@id/btnDownloadExpanded"
                    app:layout_constraintStart_toStartOf="@id/btnDownloadExpanded"
                    app:layout_constraintTop_toTopOf="@id/btnDownloadExpanded" />
                <ImageButton
                    android:id="@+id/btnLikeExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_favorite_border"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorPrimary" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <SeekBar
                android:id="@+id/seekBarSongProgressExpanded"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:max="1000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/modern_seekbar_thumb"
                app:layout_constraintBottom_toTopOf="@id/timeContainerExpanded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/timeContainerExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/layoutMainControlsExpanded">
                <TextView
                    android:id="@+id/txtTimeElapsedExpanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/txtTimeTotalExpanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMainControlsExpanded"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/layoutBottomUtilityBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <ImageButton
                    android:id="@+id/btnDislikeExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_thumb_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnPrevExpanded"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorSecondary" />
                <ImageButton
                    android:id="@+id/btnPrevExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/pill_button_bg_dark"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ctrl_fb_s"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnPauseExpanded"
                    app:layout_constraintStart_toEndOf="@id/btnDislikeExpanded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorPrimary" />
                <ImageButton
                    android:id="@+id/btnPauseExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/pill_button_bg_light"
                    android:backgroundTint="@color/white_alpha_2"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ctrl_pause_s"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNextExpanded"
                    app:layout_constraintStart_toEndOf="@id/btnPrevExpanded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/colorBackground" />
                <ImageButton
                    android:id="@+id/btnNextExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/pill_button_bg_dark"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ctrl_ff_s"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnRepeatExpanded"
                    app:layout_constraintStart_toEndOf="@id/btnPauseExpanded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorPrimary" />
                <ImageButton
                    android:id="@+id/btnRepeatExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_repeat_pl"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnNextExpanded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?android:attr/textColorSecondary" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:id="@+id/layoutBottomUtilityBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <ImageButton
                    android:id="@+id/btnVolumeExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_volume"
                    app:tint="?android:attr/textColorSecondary" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageButton
                    android:id="@+id/btnShuffleExpanded"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ctrl_shuffle"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutMiniControls"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="38dp"
        app:cardElevation="10dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Pill"
        app:strokeColor="#1FFFFFFF"
        app:strokeWidth="0.75dp">
        <com.aylis.comp.visual.ambient.AmbientBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ambientProfile="plM" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">
            <View
                android:id="@+id/albumArtPlaceholderMini"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <SeekBar
                android:id="@+id/seekBarSongProgressMini"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@null"
                app:layout_constraintEnd_toStartOf="@id/layoutPillButtonsMini"
                app:layout_constraintStart_toEndOf="@id/albumArtPlaceholderMini"
                app:layout_constraintTop_toTopOf="parent" />
            <LinearLayout
                android:id="@+id/textContainerMini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutPillButtonsMini"
                app:layout_constraintStart_toEndOf="@id/albumArtPlaceholderMini"
                app:layout_constraintTop_toBottomOf="@id/seekBarSongProgressMini">
                <TextView
                    android:id="@+id/txtSongTitleMini"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtSongArtistMini"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:shadowColor="#30000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutPillButtonsMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageButton
                    android:id="@+id/btnPrevMini"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/pill_button_bg_dark"
                    android:elevation="3dp"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_ctrl_fb_s"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/btnPauseMini"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pill_button_bg_light"
                    android:backgroundTint="@color/white_alpha_2"
                    android:clipToOutline="true"
                    android:elevation="4dp"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_ctrl_pause_s"
                    app:tint="?attr/colorSurface" />
                <ImageButton
                    android:id="@+id/btnNextMini"
                    style="@style/ExpressiveImageButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/pill_button_bg_dark"
                    android:elevation="3dp"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_ctrl_ff_s"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAlbumArtUnified"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholderart4"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.ExtraLarge"
        android:elevation="14dp" />
</FrameLayout>