<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetStart="@+id/collapsed"
        app:constraintSetEnd="@+id/expanded"
        app:duration="300"
        app:motionInterpolator="easeInOut">
        <OnSwipe
            app:touchAnchorId="@+id/player_background"
            app:touchAnchorSide="start"
            app:dragDirection="dragLeft"
            app:dragScale="10.0"
            app:onTouchUp="autoComplete"
            app:limitBoundsTo="@+id/player_background" />
    </Transition>
    <ConstraintSet android:id="@+id/collapsed">
        <Constraint
            android:id="@+id/player_background"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <CustomAttribute app:attributeName="radius" app:customDimension="28dp" />
        </Constraint>
        <Constraint android:id="@+id/txtSongTitleMini">
            <CustomAttribute app:attributeName="textSize" app:customFloatValue="13" />
        </Constraint>
        <Constraint android:id="@+id/txtSongArtistMini">
            <CustomAttribute app:attributeName="textSize" app:customFloatValue="11" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/expanded">
        <Constraint
            android:id="@+id/player_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <CustomAttribute app:attributeName="radius" app:customDimension="28dp" />
        </Constraint>
        <Constraint
            android:id="@+id/btnOverflowMini"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:elevation="12dp"
            app:layout_constraintTop_toTopOf="@+id/player_background"
            app:layout_constraintEnd_toEndOf="@+id/player_background" />
        <Constraint
            android:id="@+id/albumArtContainerMini"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:elevation="12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@+id/player_background"
            app:layout_constraintBottom_toTopOf="@+id/textContainerMini"
            app:layout_constraintStart_toStartOf="@+id/player_background"
            app:layout_constraintEnd_toEndOf="@+id/player_background">
            <CustomAttribute app:attributeName="radius" app:customDimension="16dp" />
            <CustomAttribute app:attributeName="cardElevation" app:customDimension="8dp" />
        </Constraint>
        <Constraint
            android:id="@+id/textContainerMini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:elevation="12dp"
            app:layout_constraintBottom_toTopOf="@+id/seekBarSongProgressMini"
            app:layout_constraintStart_toStartOf="@+id/player_background"
            app:layout_constraintEnd_toEndOf="@+id/player_background" />
        <Constraint android:id="@+id/txtSongTitleMini">
            <CustomAttribute app:attributeName="textSize" app:customFloatValue="16" />
        </Constraint>
        <Constraint android:id="@+id/txtSongArtistMini">
            <CustomAttribute app:attributeName="textSize" app:customFloatValue="12" />
        </Constraint>
        <Constraint
            android:id="@+id/seekBarSongProgressMini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:alpha="1"
            android:elevation="12dp"
            app:layout_constraintBottom_toTopOf="@+id/txtTimeElapsed"
            app:layout_constraintStart_toStartOf="@+id/player_background"
            app:layout_constraintEnd_toEndOf="@+id/player_background" />
        <Constraint
            android:id="@+id/txtTimeElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="visible"
            android:alpha="1"
            android:elevation="12dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutPillButtons"
            app:layout_constraintStart_toStartOf="@+id/seekBarSongProgressMini" />
        <Constraint
            android:id="@+id/txtTimeTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="visible"
            android:alpha="1"
            android:elevation="12dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutPillButtons"
            app:layout_constraintEnd_toEndOf="@+id/seekBarSongProgressMini" />
        <Constraint
            android:id="@+id/layoutPillButtons"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/player_background"
            app:layout_constraintStart_toStartOf="@+id/player_background"
            app:layout_constraintEnd_toEndOf="@+id/player_background" />
    </ConstraintSet>
</MotionScene>