<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground"
    tools:context="com.aylis.MainActivity">
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/txtLibraryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Library"
                android:textColor="?attr/colorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btnLibraryMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="4dp"
                android:background="@drawable/bg_button_pill"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:src="@drawable/ic_overflowv_2_s"
                app:tint="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutLibrary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_pill"
            android:backgroundTint="?attr/colorSecondaryContainer"
            app:tabIndicatorColor="?attr/colorOnSurface"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="?attr/colorOnSurface"
            app:tabTextColor="?attr/colorOnSecondaryContainer"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_library_all" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_library_download" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLibraryContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#4DFFFFFF"
        android:backgroundTint="?attr/colorSecondaryContainer"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LibraryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutHeader"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/layoutActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">
                <ImageButton
                    android:id="@+id/btnLibrarySearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="4dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_pill"
                    android:backgroundTint="?attr/colorSurfaceContainerHighest"
                    android:src="@drawable/ic_search"
                    app:tint="?android:attr/textColorPrimary" />
                <ImageButton
                    android:id="@+id/btnLibrarySort"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="4dp"
                    android:layout_toStartOf="@id/btnLibrarySearch"
                    android:background="@drawable/bg_button_pill"
                    android:backgroundTint="?attr/colorSurfaceContainerHighest"
                    android:src="@drawable/ic_align_right"
                    app:tint="?android:attr/textColorPrimary" />
            </RelativeLayout>
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewLibrary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button_pill"
                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                android:visibility="gone"
                app:iconifiedByDefault="false"
                app:queryHint="Search library..." />
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerLibrary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/transparent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/fast_scroller"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>