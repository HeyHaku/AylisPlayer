<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    <LinearLayout
        android:id="@+id/layout_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="App Logo"
            app:tint="?attr/colorPrimary"
            android:src="@drawable/ic_logo_placeholder" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="A\\OPEN PLAYER"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_welcome_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="200dp"
                android:paddingVertical="14dp"
                android:enabled="false"
                android:text="@string/onboarding_welcome"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_permissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="16dp"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="16dp">
            <TextView
                android:id="@+id/tv_perm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_permissions_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_perm_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_permissions_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grant_permissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minWidth="180dp"
                android:paddingVertical="12dp"
                android:text="@string/onboarding_continue"
                android:enabled="false"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/item_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_onboarding_item"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/ic_storage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/nav_ic_image_appearance"
                        app:tint="?attr/colorPrimary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_storage_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_storage_desc"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/check_storage"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_mic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_onboarding_item"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/ic_mic"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/nav_ic_audioconfig1"
                        app:tint="?attr/colorPrimary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_mic_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_mic_desc"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/check_mic"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_notif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_onboarding_item"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/ic_notif"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="?attr/colorPrimary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_notif_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_notif_desc"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/check_notif"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>