<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    <RelativeLayout
        android:id="@+id/layout_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="App Logo"
                app:tint="?attr/colorPrimary"
                android:src="@drawable/ic_logo_placeholder" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.05"
                android:text="A\\OPEN PLAYER"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_welcome_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="64dp"
            android:minWidth="200dp"
            android:paddingVertical="16dp"
            android:enabled="false"
            android:text="@string/onboarding_welcome"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_permissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="visible"
        android:animateLayoutChanges="true">
        <TextView
            android:id="@+id/tv_perm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_permissions_title"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_perm_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_perm_title"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_permissions_desc"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_perm_desc"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:animateLayoutChanges="true">
            <LinearLayout
                android:id="@+id/item_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_onboarding_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ic_storage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/nav_ic_image_appearance"
                    app:tint="?attr/colorPrimary" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_storage_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/onboarding_storage_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/check_storage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/item_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_onboarding_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ic_mic"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/nav_ic_audioconfig1"
                    app:tint="?attr/colorPrimary" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_mic_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/onboarding_mic_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/check_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/item_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ic_notif"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="?attr/colorPrimary" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_notif_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/onboarding_notif_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/check_notif"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="32dp"
            android:minWidth="200dp"
            android:paddingVertical="16dp"
            android:text="@string/onboarding_continue"
            android:enabled="false"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </RelativeLayout>
</FrameLayout>